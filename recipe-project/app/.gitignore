# Dependencies
node_modules/

# Build output
dist/
*.local

# Auto-generated SQLite wasm (regenerated by `npm run copy:wasm` on install)
public/sql-wasm.wasm

# Secrets / env
.env
.env.*
!.env.example

# Capacitor native project.
# This folder is generated by `npx cap add android` and can be regenerated.
# NOTE: once you customize native files (app icon, AndroidManifest permissions,
# signing config), REMOVE the line below so your changes are version-controlled.
android/
ios/

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor (keep .vscode shared config; ignore personal/local bits)
.vscode/*.local
.idea/
