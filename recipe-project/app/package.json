{
  "name": "recipe-app",
  "version": "0.1.0",
  "private": true,
  "description": "Personal recipe app (Manning) — Capacitor + React + on-device SQLite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "copy:wasm": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/sql-wasm.wasm')\"",
    "postinstall": "npm run copy:wasm",
    "predev": "npm run copy:wasm",
    "prebuild": "npm run copy:wasm",
    "cap:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "android:run": "npm run build && cap sync && cap run android",
    "push": "cap run android -l --external"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.1",
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/share": "^6.0.2",
    "@rollup/wasm-node": "^4.60.4",
    "jeep-sqlite": "^2.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2"
  }
}
